  var score = parseInt(localStorage.getItem('kz_score') || '0', 10);
  var streak = parseInt(localStorage.getItem('kz_streak') || '0', 10);
  var savedCoupons = {};
  try {
    savedCoupons = JSON.parse(localStorage.getItem('kz_coupons') || '{}');
  } catch(e) {}

  coupons.forEach(function(c) {
    if (savedCoupons[c.id]) c.status = savedCoupons[c.id];
  });

  function saveProgress() {
    localStorage.setItem('kz_score', score);
    localStorage.setItem('kz_streak', streak);
    var couponState = {};
    coupons.forEach(function(c) { couponState[c.id] = c.status; });
    localStorage.setItem('kz_coupons', JSON.stringify(couponState));
  }

  var currentList = data.slice();
  var cIdx = 0;

  function renderCard() {
    if (!currentList.length) {
      document.getElementById('c-kz').innerText = "Ничего не найдено";
      document.getElementById('c-trans').innerText = "";
      document.getElementById('c-ru').innerText = "Попробуйте другой запрос";
      document.getElementById('c-ctx').innerText = "";
      document.getElementById('c-count').innerText = "0 / 0";
      return;
    }
    var item = currentList[cIdx];
    document.getElementById('c-cat').innerText = item.catName;
    document.getElementById('c-kz').innerText = item.kz;
    document.getElementById('c-trans').innerText = item.trans;
    document.getElementById('c-ru').innerText = item.ru;
    document.getElementById('c-ctx').innerText = item.ctx;
    document.getElementById('c-count').innerText = (cIdx + 1) + " / " + currentList.length;
    
    document.getElementById('c-drawer').classList.remove('show');
    document.getElementById('btn-toggle').innerText = "Показать перевод 👀";
  }

  function toggleTranslation() {
    var drawer = document.getElementById('c-drawer');
    var btn = document.getElementById('btn-toggle');
    if (drawer.classList.contains('show')) {
      drawer.classList.remove('show');
      btn.innerText = "Показать перевод 👀";
    } else {
      drawer.classList.add('show');
      btn.innerText = "Скрыть перевод 🙈";
    }
  }

  function stepCard(dir) {
    if (!currentList.length) return;
    cIdx = (cIdx + dir + currentList.length) % currentList.length;
    renderCard();
  }

  function setFilter(cat, elem) {
    var chips = document.querySelectorAll('.chip');
    for (var i = 0; i < chips.length; i++) chips[i].classList.remove('active');
    elem.classList.add('active');
    document.getElementById('search-bar').value = '';
    currentList = (cat === 'all') ? data.slice() : data.filter(function(d) { return d.cat === cat; });
    cIdx = 0;
    renderCard();
  }

  function handleSearch() {
    var q = document.getElementById('search-bar').value.toLowerCase().trim();
    var chips = document.querySelectorAll('.chip');
    for (var i = 0; i < chips.length; i++) chips[i].classList.remove('active');
    if (!q) {
      currentList = data.slice();
    } else {
      currentList = data.filter(function(d) { 
        return d.kz.toLowerCase().indexOf(q) !== -1 || 
               d.ru.toLowerCase().indexOf(q) !== -1 || 
               d.trans.toLowerCase().indexOf(q) !== -1;
      });
    }
    cIdx = 0;
    renderCard();
  }

  function getMultiplier() {
    if (streak > 10) return 3;
    if (streak > 5) return 2;
    return 1;
  }

  function updateScore(isCorrect) {
    var mult = getMultiplier();
    if (isCorrect) {
      streak++;
      var gain = 2 * mult;
      score += gain;
      showFeedback(true, "+" + gain + " ⭐ (Серия: " + streak + " 🔥)");
    } else {
      streak = 0;
      score = Math.max(0, score - 1);
      showFeedback(false, "-1 ⭐ Серия сбросилась!");
    }
    saveProgress();
    document.getElementById('score').innerText = score;
    document.getElementById('streak-indicator').innerText = "🔥 " + streak;
    document.getElementById('coupon-balance').innerText = score + " ⭐";
    updateCouponsUI();
  }

  function showFeedback(isCorrect, msg) {
    var fb = document.getElementById('feedback');
    fb.className = "feedback-box " + (isCorrect ? 'correct' : 'wrong');
    fb.innerText = msg;
    fb.style.display = 'block';
  }

  var currentTaskType = 1;

  function nextTrainerQuestion() {
    document.getElementById('feedback').style.display = 'none';
    var mult = getMultiplier();
    document.getElementById('task-mult').innerText = "Серия: х" + mult + (mult > 1 ? " 🔥" : "");

    var randItem = data[Math.floor(Math.random() * data.length)];
    currentTaskType = (currentTaskType % 4) + 1;

    if (currentTaskType === 1) renderType1_Choice(randItem);
    else if (currentTaskType === 2) renderType2_Scramble(randItem);
    else if (currentTaskType === 3) renderType3_GapChoice(randItem);
    else if (currentTaskType === 4) renderType4_GapInput(randItem);
  }

  function renderType1_Choice(item) {
    document.getElementById('task-badge').innerText = "Тест на перевод";
    var toKazakh = Math.random() > 0.5;

    var correctAns;
    if (toKazakh) {
      document.getElementById('task-prompt').innerText = "«" + item.ru + "»";
      document.getElementById('task-hint').innerText = "Выбери точный перевод на казахском:";
      correctAns = item.kz;
    } else {
      document.getElementById('task-prompt').innerText = "«" + item.kz + "»";
      document.getElementById('task-hint').innerText = "Что означает эта фраза?";
      correctAns = item.ru;
    }

    var dist = data.filter(function(d) { return d.id !== item.id; });
    dist.sort(function() { return 0.5 - Math.random(); });
    var opts = [correctAns, toKazakh ? dist[0].kz : dist[0].ru, toKazakh ? dist[1].kz : dist[1].ru];
    opts.sort(function() { return 0.5 - Math.random(); });

    var body = document.getElementById('task-body');
    body.innerHTML = '<div class="options-grid" id="opt-box"></div>';
    var optBox = document.getElementById('opt-box');

    opts.forEach(function(opt) {
      var b = document.createElement('button');
      b.className = 'opt-btn';
      b.innerText = opt;
      b.onclick = function() {
        var allBtns = document.querySelectorAll('.opt-btn');
        allBtns.forEach(function(btn) { btn.style.pointerEvents = 'none'; });
        if (opt === correctAns) {
          b.classList.add('correct');
          updateScore(true);
        } else {
          b.classList.add('wrong');
          allBtns.forEach(function(btn) { if (btn.innerText === correctAns) btn.classList.add('correct'); });
          updateScore(false);
        }
        setTimeout(nextTrainerQuestion, 1200);
      };
      optBox.appendChild(b);
    });
  }

  function renderType2_Scramble(item) {
    document.getElementById('task-badge').innerText = "Собери предложение";
    document.getElementById('task-prompt').innerText = "«" + item.ru + "»";
    document.getElementById('task-hint').innerText = "Выбери только нужные слова в правильном порядке:";

    var cleanKz = item.kz.replace(/[!?,.]/g, '').trim();
    var correctWords = cleanKz.split(/\s+/);
    
    var allWordsPool = [];
    data.forEach(function(d) {
      d.kz.replace(/[!?,.]/g, '').split(/\s+/).forEach(function(w) {
        var cleanW = w.trim();
        if (cleanW && !correctWords.some(function(cw) { return cw.toLowerCase() === cleanW.toLowerCase(); }) && allWordsPool.indexOf(cleanW) === -1) {
          allWordsPool.push(cleanW);
        }
      });
    });

    var extraWordsCount = correctWords.length <= 2 ? 3 : 2;
    allWordsPool.sort(function() { return 0.5 - Math.random(); });
    var extraWords = allWordsPool.slice(0, extraWordsCount);

    var wordBankData = correctWords.concat(extraWords).map(function(word, idx) {
      return { id: 'w_' + idx + '_' + Math.random().toString(36).substring(2, 6), text: word };
    }).sort(function() { return 0.5 - Math.random(); });

    var userSelected = [];

    var body = document.getElementById('task-body');
    body.innerHTML = 
      '<div class="build-area" id="build-area">' +
        '<span id="build-placeholder" style="color:var(--text-muted); font-size:0.88rem;">Нажимай на слова внизу...</span>' +
      '</div>' +
      '<div class="word-bank" id="word-bank"></div>' +
      '<div style="display:flex; gap:10px; margin-top:12px;">' +
        '<button class="btn-main" style="background:#FAF8F5; color:#2C2623; border:1.5px solid var(--sand); flex:1;" onclick="resetScramble()">Сбросить ↺</button>' +
        '<button class="btn-main" style="flex:1;" id="btn-check-scramble" onclick="checkScramble()">Готово ✨</button>' +
      '</div>';

    var buildArea = document.getElementById('build-area');
    var wordBank = document.getElementById('word-bank');
    var placeholder = document.getElementById('build-placeholder');

    function updateBuildArea() {
      buildArea.innerHTML = '';
      if (userSelected.length === 0) {
        buildArea.appendChild(placeholder);
        return;
      }
      userSelected.forEach(function(itemObj, index) {
        var chip = document.createElement('span');
        chip.className = 'word-chip';
        chip.style.background = 'var(--sand)';
        chip.innerText = itemObj.text;
        chip.onclick = function() {
          userSelected.splice(index, 1);
          var el = document.getElementById(itemObj.id);
          if (el) el.classList.remove('used');
          updateBuildArea();
        };
        buildArea.appendChild(chip);
      });
    }

    window.resetScramble = function() {
      userSelected.length = 0;
      updateBuildArea();
      document.querySelectorAll('.word-chip').forEach(function(c) { c.classList.remove('used'); });
    };

    window.checkScramble = function() {
      if (userSelected.length === 0) return;
      var userSentence = userSelected.map(function(w) { return w.text; }).join(' ');
      var targetSentence = correctWords.join(' ');

      if (userSentence === targetSentence) {
        updateScore(true);
        setTimeout(nextTrainerQuestion, 1100);
      } else {
        updateScore(false);
        showFeedback(false, "Правильный ответ: «" + item.kz + "»");
        setTimeout(nextTrainerQuestion, 2200);
      }
    };

    wordBankData.forEach(function(itemObj) {
      var chip = document.createElement('button');
      chip.className = 'word-chip';
      chip.id = itemObj.id;
      chip.innerText = itemObj.text;
      chip.onclick = function() {
        chip.classList.add('used');
        userSelected.push(itemObj);
        updateBuildArea();
      };
      wordBank.appendChild(chip);
    });
  }

  function renderType3_GapChoice(item) {
    document.getElementById('task-badge').innerText = "Вставь пропущенное слово";
    var words = item.kz.split(' ');
    if (words.length < 2) {
      renderType1_Choice(item);
      return;
    }

    var gapIndex = -1;
    for (var i = 0; i < words.length; i++) {
      if (words[i].toLowerCase() === 'сәл') { gapIndex = i; break; }
    }
    if (gapIndex === -1) gapIndex = Math.floor(Math.random() * words.length);

    var targetWord = words[gapIndex].replace(/[!?,]/g, '');
    var displaySentence = words.map(function(w, idx) { return idx === gapIndex ? '_____' : w; }).join(' ');

    document.getElementById('task-prompt').innerText = displaySentence;
    document.getElementById('task-hint').innerText = "Смысл: «" + item.ru + "»";

    var fakeDist = ['сәл', 'шай', 'нан', 'су', 'жақсы', 'рахмет', 'қалай', 'бар'].filter(function(w) { return w !== targetWord.toLowerCase(); });
    fakeDist.sort(function() { return 0.5 - Math.random(); });
    var opts = [targetWord, fakeDist[0], fakeDist[1]].sort(function() { return 0.5 - Math.random(); });

    var body = document.getElementById('task-body');
    body.innerHTML = '<div class="options-grid" id="opt-box-gap"></div>';
    var optBox = document.getElementById('opt-box-gap');

    opts.forEach(function(opt) {
      var b = document.createElement('button');
      b.className = 'opt-btn';
      b.innerText = opt;
      b.onclick = function() {
        var allBtns = document.querySelectorAll('.opt-btn');
        allBtns.forEach(function(btn) { btn.style.pointerEvents = 'none'; });
        if (opt.toLowerCase() === targetWord.toLowerCase()) {
          b.classList.add('correct');
          updateScore(true);
        } else {
          b.classList.add('wrong');
          allBtns.forEach(function(btn) { 
            if (btn.innerText.toLowerCase() === targetWord.toLowerCase()) btn.classList.add('correct'); 
          });
          updateScore(false);
        }
        setTimeout(nextTrainerQuestion, 1200);
      };
      optBox.appendChild(b);
    });
  }

  function renderType4_GapInput(item) {
    document.getElementById('task-badge').innerText = "Впиши слово сама";
    var words = item.kz.split(' ');
    if (words.length < 2) {
      renderType1_Choice(item);
      return;
    }

    var targets = ['сәл', 'шай', 'нан', 'су', 'бар', 'өте'];
    var gapIndex = 0;
    for (var i = 0; i < words.length; i++) {
      var cleanW = words[i].toLowerCase().replace(/[!?,]/g, '');
      if (targets.indexOf(cleanW) !== -1) { gapIndex = i; break; }
    }

    var targetWord = words[gapIndex].replace(/[!?,]/g, '');
    var displaySentence = words.map(function(w, idx) { return idx === gapIndex ? '_____' : w; }).join(' ');

    document.getElementById('task-prompt').innerText = displaySentence;
    document.getElementById('task-hint').innerText = "Смысл: «" + item.ru + "»";

    var body = document.getElementById('task-body');
    body.innerHTML = 
      '<div class="input-box">' +
        '<input type="text" class="fill-input" id="gap-manual-input" placeholder="Введи слово...">' +
        '<button class="btn-main" id="btn-check-manual">Проверить ответ ✨</button>' +
      '</div>';

    document.getElementById('btn-check-manual').onclick = function() { checkManualInput(targetWord); };
    document.getElementById('gap-manual-input').addEventListener("keyup", function(event) {
      if (event.key === "Enter") checkManualInput(targetWord);
    });
  }

  function checkManualInput(targetWord) {
    var inp = document.getElementById('gap-manual-input');
    if (!inp) return;
    var val = inp.value.trim().toLowerCase();
    var cleanTarget = targetWord.toLowerCase().replace(/[!?,]/g, '');

    if (val === cleanTarget) {
      inp.style.borderColor = "var(--sage)";
      inp.style.color = "var(--sage)";
      updateScore(true);
      setTimeout(nextTrainerQuestion, 1100);
    } else {
      inp.style.borderColor = "var(--terracotta)";
      inp.style.color = "var(--terracotta)";
      updateScore(false);
      showFeedback(false, "Правильный ответ: «" + cleanTarget + "»");
      setTimeout(nextTrainerQuestion, 2000);
    }
  }

  function updateCouponsUI() {
    var container = document.getElementById('coupons-container');
    container.innerHTML = '';

    coupons.forEach(function(c) {
      var isUnlocked = score >= c.cost;
      var card = document.createElement('div');
      card.className = "coupon-card " + (isUnlocked ? 'unlocked' : '') + " " + (c.status === 'redeemed' ? 'redeemed' : '');

      var btnHtml = '';
      if (c.status === 'redeemed') {
        btnHtml = '<button class="btn-coupon used">Активирован 🎉</button>';
      } else if (isUnlocked) {
        btnHtml = '<button class="btn-coupon active" onclick="redeemCoupon(\'' + c.id + '\')">Активировать у мужа 🎁</button>';
      } else {
        btnHtml = '<button class="btn-coupon">Нужно ещё ' + (c.cost - score) + ' ⭐</button>';
      }

      card.innerHTML = 
        '<div class="coupon-header">' +
          '<div class="coupon-title">' + c.title + '</div>' +
          '<span class="coupon-cost">' + c.cost + ' ⭐</span>' +
        '</div>' +
        '<div class="coupon-desc">' + c.desc + '</div>' +
        btnHtml;
      container.appendChild(card);
    });
  }

  function redeemCoupon(id) {
    var c = coupons.find(function(item) { return item.id === id; });
    if (!c || c.status === 'redeemed') return;
    c.status = 'redeemed';
    saveProgress();
    alert("🎉 Поздравляем, Жаным!\nКупон «" + c.title + "» активирован!\nПокажи этот экран мужу прямо сейчас! ❤️");
    updateCouponsUI();
  }

  var scenarios = [
    {
      title: "☕ Уютный чай за дастарханом",
      steps: [
        { them: "Сәлем, жаным! Қалайсың?", choices: [{ t: "Жақсы, рақмет! Қалайсыз?", n: 1 }] },
        { them: "Жақсымыз бәріміз. Сәл шаршамадың ба?", choices: [{ t: "Сәл шаршадым, шай ішейікші!", n: 2 }] },
        { them: "Қазір ыстық шай қоямын! Бауырсақ жейсің бе?", choices: [{ t: "Иә, қарным ашты! Дәмді көрінеді", n: 3 }] },
        { them: "Міне, алыңдар! Астарың дәмді болсын!", choices: [{ t: "Үлкен рақмет! Қолыңызға дерт бермесін!", n: 4 }] }
      ]
    },
    {
      title: "📱 Звонок от мамы",
      steps: [
        { them: "Алло, жаным, сәлем! Қалайсыңдар?", choices: [{ t: "Сәлеметсіз бе! Иә, бәрі жақсы бізде", n: 1 }] },
        { them: "Ұлым үйде ме? Қолы бос па екен?", choices: [{ t: "Иә, үйде. Қазір телефонды беремін!", n: 2 }] },
        { them: "Жарайды, айналайын, көп рақмет!", choices: [{ t: "Оқасы жоқ, сау болыңыз!", n: 3 }] }
      ]
    },
    {
      title: "🍳 Помощь на кухне",
      steps: [
        { them: "Қазір кешкі тамақты бастаймын", choices: [{ t: "Көмек керек пе? Мен көкөністерді турайын", n: 1 }] },
        { them: "Иә, жақсы болар еді, рақмет!", choices: [{ t: "Тақтайша мен пышақ қайда жатыр?", n: 2 }] },
        { them: "Міне, үстелдің үстінде тұр!", choices: [{ t: "Жарайды, қазір бәрін дайындаймын", n: 3 }] }
      ]
    }
  ];

  var activeScen = 0;

  function pickScenario(idx) {
    activeScen = idx;
    [0, 1, 2].forEach(function(i) {
      document.getElementById('scen-tab-' + i).classList.toggle('active', i === idx);
    });
    document.getElementById('scen-title').innerText = scenarios[idx].title;
    startDialogue();
  }

  function startDialogue() {
    var flow = document.getElementById('chat-flow');
    flow.innerHTML = '';
    runStep(0);
  }

  function runStep(stepIdx) {
    var scen = scenarios[activeScen];
    var flow = document.getElementById('chat-flow');
    var actions = document.getElementById('chat-actions');
    actions.innerHTML = '';

    if (stepIdx >= scen.steps.length) {
      actions.innerHTML = 
        '<div style="text-align:center; color:var(--sage); font-weight:700; padding:8px;">🎉 Тамаша! Диалог пройден!</div>' +
        '<button class="btn-main" onclick="startDialogue()">Повторить этот диалог</button>';
      score += 20;
      saveProgress();
      document.getElementById('score').innerText = score;
      document.getElementById('coupon-balance').innerText = score + " ⭐";
      updateCouponsUI();
      return;
    }

    var s = scen.steps[stepIdx];
    flow.innerHTML += '<div class="bubble them">' + s.them + '</div>';

    s.choices.forEach(function(ch) {
      var b = document.createElement('button');
      b.className = 'btn-main';
      b.style.background = '#FAF8F5';
      b.style.color = '#2C2623';
      b.style.border = '1.5px solid var(--sand)';
      b.innerText = ch.t;
      b.onclick = function() {
        flow.innerHTML += '<div class="bubble me">' + ch.t + '</div>';
        actions.innerHTML = '';
        setTimeout(function() { runStep(ch.n); }, 500);
      };
      actions.appendChild(b);
    });
  }

  function showTab(idx) {
    ['cards', 'quiz', 'coupons', 'dialogue'].forEach(function(name, i) {
      document.getElementById('tab' + i).classList.toggle('active', i === idx);
      document.getElementById('view-' + name).classList.toggle('active', i === idx);
    });
    if (idx === 1) nextTrainerQuestion();
    if (idx === 2) updateCouponsUI();
    if (idx === 3) pickScenario(activeScen);
  }

  document.getElementById('score').innerText = score;
  document.getElementById('streak-indicator').innerText = "🔥 " + streak;
  document.getElementById('coupon-balance').innerText = score + " ⭐";
  renderCard();
  updateCouponsUI();
</script>

</body>
</html>
